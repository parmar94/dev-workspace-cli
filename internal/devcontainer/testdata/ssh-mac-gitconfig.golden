=== .devcontainer/devcontainer.json
{
  "name": "ssh-mac",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    }
  },
  "mounts": [
    "source=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock,type=bind",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig-host,type=bind,readonly"
  ],
  "containerEnv": {
    "SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock"
  },
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "postStartCommand": "sudo chown \"$(id -u)\" /run/host-services/ssh-auth.sock",
  "remoteUser": "vscode"
}
=== .devcontainer/scripts/post-create.sh (exec)
#!/usr/bin/env bash
# Generated by dws. Runs once after the container is created.
set -euo pipefail
cd "$(dirname "$0")"

echo "==> Including host git config"
git config --global --get-all include.path | grep -qx '~/.gitconfig-host' ||
  git config --global --add include.path '~/.gitconfig-host'
