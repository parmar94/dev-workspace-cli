=== .devcontainer/devcontainer.json
{
  "name": "sandbox",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "latest"
    }
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/python",
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/anthropics/devcontainer-features/claude-code",
    "ghcr.io/devcontainers/features/aws-cli"
  ],
  "mounts": [
    "source=dws-claude,target=/home/vscode/.claude,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "remoteUser": "vscode"
}
=== .devcontainer/scripts/post-create.sh (exec)
#!/usr/bin/env bash
# Generated by dws. Runs once after the container is created.
set -euo pipefail
cd "$(dirname "$0")"

echo "==> Fixing volume ownership"
sudo chown -R "$(id -u):$(id -g)" /home/vscode/.claude

echo "==> Installing Claude Code sandbox dependencies"
sudo apt-get update && sudo apt-get install -y --no-install-recommends bubblewrap socat

echo "==> Installing Claude Code agent policy"
sudo install -D -m 0644 ../agent-policy/claude-managed-settings.json /etc/claude-code/managed-settings.d/dws-guard.json
=== .devcontainer/agent-policy/claude-managed-settings.json
{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.aws/**)",
      "Bash(printenv *)",
      "Bash(env *)",
      "Bash(aws configure export-credentials *)",
      "Bash(aws configure get *)",
      "Bash(aws sts get-session-token *)"
    ]
  },
  "sandbox": {
    "credentials": {
      "envVars": [
        {
          "mode": "deny",
          "name": "AWS_ACCESS_KEY_ID"
        },
        {
          "mode": "deny",
          "name": "AWS_SECRET_ACCESS_KEY"
        },
        {
          "mode": "deny",
          "name": "AWS_SESSION_TOKEN"
        }
      ]
    },
    "enableWeakerNestedSandbox": true,
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "/workspaces/**/.env",
        "/workspaces/**/.env.*",
        "~/.aws"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org"
      ]
    }
  }
}
