=== .devcontainer/devcontainer.json
{
  "name": "guard",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/go",
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/anthropics/devcontainer-features/claude-code",
    "ghcr.io/devcontainers/features/aws-cli",
    "ghcr.io/devcontainers/features/github-cli"
  ],
  "mounts": [
    "source=dws-claude,target=/home/vscode/.claude,type=volume",
    "source=dws-codex,target=/home/vscode/.codex,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "remoteUser": "vscode"
}
=== .devcontainer/scripts/post-create.sh (exec)
#!/usr/bin/env bash
# Generated by dws. Runs once after the container is created.
set -euo pipefail
cd "$(dirname "$0")"

echo "==> Fixing volume ownership"
sudo chown -R "$(id -u):$(id -g)" /home/vscode/.claude /home/vscode/.codex

echo "==> Installing codex"
bash ./codex.sh

echo "==> Installing Claude Code agent guard"
sudo install -D -m 0644 ../agent-policy/claude-managed-settings.json /etc/claude-code/managed-settings.d/dws-guard.json

echo "==> Installing Codex agent guard"
cfg="$HOME/.codex/config.toml"
mkdir -p "$(dirname "$cfg")" && touch "$cfg"
sed -i '/^# >>> dws agent guard/,/^# <<< dws agent guard/d' "$cfg"
if grep -q '^\[shell_environment_policy\]' "$cfg"; then
  echo "    skipped: $cfg already has [shell_environment_policy]; merge this in yourself:" >&2
  sed 's/^/    /' ../agent-policy/codex-config.toml >&2
else
  cat ../agent-policy/codex-config.toml >> "$cfg"
fi
=== .devcontainer/scripts/codex.sh (exec)
#!/usr/bin/env bash
# OpenAI Codex CLI (agent). Generated by dws.
set -euo pipefail

npm install -g @openai/codex
=== .devcontainer/agent-policy/claude-managed-settings.json
{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Bash(printenv *)",
      "Bash(env *)",
      "Bash(aws configure export-credentials *)",
      "Bash(aws configure get *)",
      "Bash(aws sts get-session-token *)",
      "Bash(gh auth token *)"
    ]
  }
}
=== .devcontainer/agent-policy/codex-config.toml
# >>> dws agent guard (managed by dws; edits between these markers are replaced)
[shell_environment_policy]
filters = { "AWS_*" = "exclude", "GH_TOKEN" = "exclude", "GITHUB_TOKEN" = "exclude" }
# <<< dws agent guard
